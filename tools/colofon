#!/usr/bin/env bash
set -euo pipefail

APP=${COLOFON_HOME:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}

usage() {
  cat <<'EOF'
Colofon - accessible Typst document factory

Usage:
  colofon doc <file-or-dir>... [make_doc options]
  colofon book <book.yaml> [make_book options]
  colofon form <form.typ> [make_form options]  # optional AGPL form image/extra
  colofon lint <chapter.md>...
  colofon convert <chapter.typ>
  colofon describe [--json]
  colofon doctor [--json]
  colofon mcp [--workspace <dir>]
  colofon test
  colofon version

The doc, book, form, and lint commands use the current directory as the project
root unless --root is supplied. Fillable forms require the optional PyMuPDF extra
or the explicitly AGPL-licensed colofon-form image. In Docker, mount a project at
/work and run the container with /work as its working directory.
EOF
}

has_root() {
  for arg in "$@"; do
    case "$arg" in
      --root|--root=*) return 0 ;;
    esac
  done
  return 1
}

case "${1:-help}" in
  doc)
    shift
    if has_root "$@"; then
      exec python3 "$APP/tools/make_doc.py" "$@"
    fi
    exec python3 "$APP/tools/make_doc.py" --root "$PWD" "$@"
    ;;
  book)
    shift
    if has_root "$@"; then
      exec python3 "$APP/tools/make_book.py" "$@"
    fi
    exec python3 "$APP/tools/make_book.py" --root "$PWD" "$@"
    ;;
  form)
    shift
    if ! python3 -c 'import pymupdf' >/dev/null 2>&1; then
      printf '%s\n' \
        'colofon: fillable forms require the optional AGPL-licensed PyMuPDF extra.' \
        'Use ghcr.io/jmurray2011/colofon-form, or install tools/requirements-form.txt.' >&2
      exit 2
    fi
    if has_root "$@"; then
      exec python3 "$APP/tools/make_form.py" "$@"
    fi
    exec python3 "$APP/tools/make_form.py" --root "$PWD" "$@"
    ;;
  lint)
    shift
    if has_root "$@"; then
      exec python3 "$APP/tools/bookmd_lint.py" "$@"
    fi
    exec python3 "$APP/tools/bookmd_lint.py" --root "$PWD" "$@"
    ;;
  convert)
    shift
    exec python3 "$APP/tools/typ2md.py" "$@"
    ;;
  describe|doctor)
    command=$1
    shift
    exec python3 "$APP/tools/colofon_info.py" "$command" "$@"
    ;;
  mcp)
    shift
    if [[ -x "$APP/bin/colofon-mcp" ]]; then
      exec "$APP/bin/colofon-mcp" --colofon "$APP/tools/colofon" "$@"
    fi
    exec /usr/local/bin/colofon-mcp --colofon "$APP/tools/colofon" "$@"
    ;;
  test)
    shift
    cd "$APP"
    python3 -m unittest discover -s tests -v
    if [[ "${COLOFON_FORMS:-0}" == 1 ]]; then
      exec ./build.sh --forms-only "$@"
    fi
    exec ./build.sh "$@"
    ;;
  version)
    typst_bin=${TYPST:-$HOME/.local/bin/typst}
    verapdf_bin=${VERAPDF:-$HOME/.local/verapdf/verapdf}
    printf 'Colofon %s\n' "$(<"$APP/VERSION")"
    "$typst_bin" --version
    "$verapdf_bin" --version
    python3 --version
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'colofon: unknown command: %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
