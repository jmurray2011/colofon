# Optional shell environment overrides for the factory tools. This file is not loaded
# automatically; copy it to `.env`, edit it, then run `set -a; source .env; set +a`.
TYPST="/path/to/typst"
VERAPDF="/path/to/verapdf"

# Override these only when consuming colofon packages or fonts from another location.
# COLOFON_PACKAGES="/path/to/colofon/packages"
# COLOFON_FONTS="/path/to/colofon/engine/fonts"

# Deliberate escape hatch for local drafts only. Published artifacts should leave this
# unset so a missing verifier fails the build.
# COLOFON_ALLOW_UNVERIFIED=1
